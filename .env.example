# Next.js Environment Variables
# Socket.IO Server URL for video calls
# For local development, you can set this to http://localhost:3001 (or leave unset to use the default in code)
# For production, set to your deployed Socket.IO server URL (e.g., https://your-socket-server.onrender.com)
NEXT_PUBLIC_SOCKET_URL=

# STUN/TURN Server Configuration for WebRTC NAT Traversal
# Google free STUN server
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302

# For production TURN server (add your TURN server credentials if needed)
# Example using a free TURN evaluation server (replace with your own for production):
# NEXT_PUBLIC_TURN_SERVER=turn:your-turn-server.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-credential

# MongoDB Configuration
# For local development with MongoDB installed:
MONGODB_URI=mongodb+srv://Ramzi:16716@autismcare.ir29elb.mongodb.net/autismcare?retryWrites=true&w=majority&appName=AutismCare

# For MongoDB Atlas, use format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# DNS servers for MongoDB Atlas SRV DNS resolution (optional, helps with IPv6 DNS issues)
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1